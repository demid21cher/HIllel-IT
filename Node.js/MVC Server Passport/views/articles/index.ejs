<!DOCTYPE html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />

    <title>Статті</title>

    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body class="<%= theme %>">
    <h1>Список статей</h1>

    <ul>
      <% articles.forEach(article => { %>

      <li>
        <a href="/articles/<%= article.id %>"> <%= article.title %> </a>

        — <%= article.author %>
      </li>

      <% }) %>
    </ul>
  </body>
</html>
