doctype html
html(lang="uk")
  head
    meta(charset="UTF-8")
    title Користувачі

    link(rel="icon" href="/favicon.ico")
    link(rel="stylesheet" href="/styles.css")

  body(class=theme)

    h1 Список користувачів

    ul
      each user in users
        li
          a(href='/users/' + user.id)= user.name
          |  — #{user.email}
